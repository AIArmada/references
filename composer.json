{
    "name": "aiarmada/references",
    "description": "Generic reference/source management for Laravel - scholarly references with hierarchical parts support",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "aiarmada/commerce-support": "self.version",
        "spatie/laravel-medialibrary": "^11.23.11",
        "spatie/laravel-package-tools": "^1.93.3",
        "spatie/laravel-sluggable": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "AIArmada\\References\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "AIArmada\\References\\ReferencesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "nikic/php-parser": "^5"
    },
    "scripts": {
        "arch:boundaries": "@php tools/package-check.php",
        "arch:boundaries:diff": "@php tools/package-check.php --diff-base=main",
        "arch:writes": "@php tools/arch-writes.php",
        "arch:check": [
            "@arch:boundaries",
            "@arch:writes"
        ]
    }
}
